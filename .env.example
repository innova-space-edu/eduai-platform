# EduAI Platform — variables de entorno de referencia
# NO colocar claves reales en este archivo. Los secretos se configuran en Vercel como Sensitive.

# ── Aplicación ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Compatibilidad si la instalación aún usa la anon key legacy:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR. Nunca usar NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: algunas rutas server-side también aceptan esta forma explícita.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Bóveda Premium Personal / BYOK.
# Generar un secreto largo y aleatorio distinto de SUPABASE_SERVICE_ROLE_KEY.
# Solo servidor. Nunca NEXT_PUBLIC_.
EDUAI_CREDENTIALS_MASTER_KEY=

# ── Google AI / Gemini ────────────────────────────────────────────────────────
# Clave principal. Puede cubrir texto, imagen, embeddings y video si la cuenta tiene cuota.
GEMINI_API_KEY=
# Opcionales para separar cuotas/proyectos sin cambiar la app:
GEMINI_API_KEY_TEXT=
GEMINI_API_KEY_IMAGE=
GEMINI_API_KEY_VIDEO=

# Modelos configurables sin volver a desplegar código por cambio de nombre.
GOOGLE_TEXT_MODEL_PRIMARY=gemini-3.6-flash
GOOGLE_TEXT_MODEL_LITE=gemini-3.5-flash-lite
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_IMAGE_MODEL_PRIMARY=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL_PRIMARY=veo-3.1-lite-generate-preview
GOOGLE_VIDEO_RESOLUTION=720p

# Compatibilidad temporal con configuración anterior.
GEMINI_TEXT_MODEL_PRIMARY=gemini-3.6-flash
GEMINI_TEXT_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL_PRIMARY=gemini-3.1-flash-image

# ── Google Vertex AI administrado (opcional; NO reemplaza Gemini API) ─────────
# Este flag mueve SOLO texto/structured/streaming del proveedor Google a Vertex AI.
# Image Studio y Video Studio mantienen su camino actual estable.
GOOGLE_GENAI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex requiere identidad server-side de Google Cloud (ADC/Workload Identity).
# No subir JSON de service account al repositorio ni exponerlo con NEXT_PUBLIC_.

# ── EduAI Model Cloud / Vertex Model Garden (opcional, apagado por defecto) ───
# Backend adicional para modelos abiertos/custom desplegados en un Vertex AI Endpoint
# (por ejemplo vLLM). No sustituye Gemini ni los proveedores externos: se inserta
# como fallback después de Google para text/structured/long_context/code.
VERTEX_MODEL_CLOUD_ENABLED=false
VERTEX_MODEL_CLOUD_ENDPOINT_ID=
VERTEX_MODEL_CLOUD_MODEL_ID=
VERTEX_MODEL_CLOUD_LOCATION=us-central1
# "completion" para endpoints vLLM /completions; "chat" para chat-completions.
VERTEX_MODEL_CLOUD_PROTOCOL=completion
VERTEX_MODEL_CLOUD_TIMEOUT_MS=60000

# Google Cloud Workload Identity Federation para Vercel OIDC.
# No son API keys. Vercel entrega el token OIDC automáticamente en build/runtime
# cuando Secure Backend Access (OIDC) está habilitado; no guardar un JSON de
# service account ni una private key en Vercel.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# VERCEL_OIDC_TOKEN NO se configura manualmente en producción.

# ── Proveedores alternativos ──────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_RESEARCH_MODEL=groq/compound

OPENROUTER_API_KEY=
# Pools opcionales: el Gateway también acepta _1/_2/_3.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Auto Router selecciona dinámicamente entre múltiples modelos/proveedores.
OPENROUTER_TEXT_MODEL=openrouter/auto
OPENROUTER_STRUCTURED_MODEL=openrouter/auto
# Política conservadora por defecto: costo bajo y sin proveedores que declaren
# recopilación de prompts, salvo que el administrador lo habilite explícitamente.
OPENROUTER_PROVIDER_SORT=price
OPENROUTER_ALLOW_DATA_COLLECTION=false
OPENROUTER_ZDR_ONLY=false

TOGETHER_API_KEY=
# Pools opcionales: el Gateway también acepta _1/_2/_3.
TOGETHER_API_KEY_1=
TOGETHER_API_KEY_2=
TOGETHER_API_KEY_3=
TOGETHER_TEXT_MODEL=Qwen/Qwen3.5-9B

CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=gpt-oss-120b

HF_TOKEN=

# Timeout común para proveedores HTTP alternativos.
EDUAI_AI_PROVIDER_TIMEOUT_MS=60000

# ── Routing EduAI por capacidad (opcionales) ──────────────────────────────────
# Google queda primero por defecto. Si Model Cloud está desactivado/incompleto,
# se salta automáticamente y continúa con Groq/OpenRouter/Cerebras/Together.
# El registro ai_provider_models permite cambiar el modelo de cada proveedor
# sin modificar los módulos consumidores.
EDUAI_AI_PROVIDER_ORDER_TEXT=google,vertex-model-cloud,groq,openrouter,cerebras,together
EDUAI_AI_PROVIDER_ORDER_STRUCTURED=google,vertex-model-cloud,groq,openrouter,cerebras,together
EDUAI_AI_PROVIDER_ORDER_LONG_CONTEXT=google,vertex-model-cloud,openrouter,groq,cerebras,together
EDUAI_AI_PROVIDER_ORDER_RESEARCH=google,groq,openrouter
EDUAI_AI_PROVIDER_ORDER_CODE=google,vertex-model-cloud,groq,cerebras,openrouter,together
EDUAI_AI_PROVIDER_ORDER_IMAGE=google,openrouter,together
# El Video Router usa VIDEO_PROVIDER_ORDER más abajo.
EDUAI_AI_PROVIDER_ORDER_VIDEO=wan,hf-gradio,hf-space,google

# ── Image Studio ──────────────────────────────────────────────────────────────
# Gemini 3.1 primero; el resto queda como fallback automático.
IMAGE_PROVIDER_ORDER_FAST=gemini,pollinations,openrouter,together,huggingface
IMAGE_PROVIDER_ORDER_QUALITY=gemini,openrouter,together,huggingface,pollinations
IMAGE_PROVIDER_ORDER_EDUCATIONAL=gemini,openrouter,pollinations,together,huggingface
IMAGE_PROMPT_OPTIMIZER_ENABLED=true
IMAGE_PROMPT_OPTIMIZER_MODE=quality_only

# ── Video Studio: automático / ahorro primero ─────────────────────────────────
# Reuse Engine → WAN → HF Gradio → HF legacy → Google Veo premium.
VIDEO_PROVIDER_ORDER=wan,hf-gradio,hf-space,google

# WAN / Alibaba Model Studio — cuota gratuita cuando esté disponible.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
WAN_VIDEO_REGION=singapore
WAN_VIDEO_MODEL_TEXT=wan2.7-t2v-2026-06-12
WAN_VIDEO_MODEL_IMAGE=wan2.7-i2v-2026-04-25

# Hugging Face / Gradio asíncrono — Space/worker compatible.
HF_GRADIO_VIDEO_BASE_URL=
HF_GRADIO_VIDEO_API_NAME=generate
HF_GRADIO_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers

# Adapter HTTP legacy opcional durante la transición.
HF_SPACE_VIDEO_API_URL=
HF_SPACE_VIDEO_API_TOKEN=

# Si se configura cron de respaldo, usar el secreto nativo de Vercel.
CRON_SECRET=
# Alias aceptado por el endpoint actual si se necesita ejecutar desde otro scheduler.
VIDEO_CRON_SECRET=

# Premium Personal / BYOK (fal.ai, Replicate, Hugging Face catálogo):
# NO configurar API keys globales de usuarios aquí.
# Cada usuario las conecta dentro de Video Studio y EduAI las cifra server-side.

# ── Cache rápido / rate limiting ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Investigación / extracción web opcional ──────────────────────────────────
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── OpenRouter metadata ───────────────────────────────────────────────────────
OPENROUTER_REFERER=https://eduaiplatformclon.vercel.app
OPENROUTER_APP_TITLE=EduAI Platform
