# EduAI Platform — variables de entorno de referencia
# NO colocar claves reales en este archivo. Los secretos se configuran en Vercel como Sensitive.

# ── Aplicación ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Compatibilidad si la instalación aún usa la anon key legacy:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR. Nunca usar NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: algunas rutas server-side también aceptan esta forma explícita.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# ── Google AI / Gemini ────────────────────────────────────────────────────────
# Clave principal. Puede cubrir texto, imagen y video.
GEMINI_API_KEY=
# Opcionales para separar cuotas/proyectos sin cambiar la app:
GEMINI_API_KEY_TEXT=
GEMINI_API_KEY_IMAGE=
GEMINI_API_KEY_VIDEO=

# Modelos configurables sin volver a desplegar código por cambio de nombre.
GOOGLE_TEXT_MODEL_PRIMARY=gemini-3.6-flash
GOOGLE_TEXT_MODEL_LITE=gemini-3.5-flash-lite
GOOGLE_IMAGE_MODEL_PRIMARY=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL_PRIMARY=veo-3.1-generate-preview
GOOGLE_VIDEO_RESOLUTION=720p

# Compatibilidad temporal con configuración anterior.
GEMINI_TEXT_MODEL_PRIMARY=gemini-3.6-flash
GEMINI_TEXT_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL_PRIMARY=gemini-3.1-flash-image

# ── Proveedores alternativos ──────────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=

# ── Routing EduAI por capacidad (opcionales) ──────────────────────────────────
EDUAI_AI_PROVIDER_ORDER_TEXT=google,groq,openrouter
EDUAI_AI_PROVIDER_ORDER_STRUCTURED=google,groq,openrouter
EDUAI_AI_PROVIDER_ORDER_LONG_CONTEXT=google,openrouter
EDUAI_AI_PROVIDER_ORDER_IMAGE=google,openrouter,together
EDUAI_AI_PROVIDER_ORDER_VIDEO=google

# Image Studio existente
IMAGE_PROVIDER_ORDER_FAST=pollinations,openrouter,together,huggingface,gemini
IMAGE_PROVIDER_ORDER_QUALITY=gemini,openrouter,together,huggingface,pollinations
IMAGE_PROVIDER_ORDER_EDUCATIONAL=gemini,openrouter,pollinations,together,huggingface
IMAGE_PROMPT_OPTIMIZER_ENABLED=true
IMAGE_PROMPT_OPTIMIZER_MODE=quality_only

# Video Studio
VIDEO_PROVIDER_ORDER=google,hf-space
# Si se configura cron de respaldo, usar el secreto nativo de Vercel.
CRON_SECRET=
# Alias aceptado por el endpoint actual si se necesita ejecutar desde otro scheduler.
VIDEO_CRON_SECRET=
# Provider de respaldo opcional.
HF_SPACE_VIDEO_API_URL=
HF_SPACE_VIDEO_API_TOKEN=

# ── Cache rápido / rate limiting ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Investigación / extracción web opcional ──────────────────────────────────
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── OpenRouter metadata ───────────────────────────────────────────────────────
OPENROUTER_REFERER=https://eduaiplatformclon.vercel.app
OPENROUTER_APP_TITLE=EduAI Platform
