{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node scripts/normalize-npm-lockfile.mjs && npm install --registry=https://registry.npmjs.org/",
  "rewrites": [
    {
      "source": "/api/agents/audio/songs",
      "destination": "/api/agents/audio/generate?kind=song"
    },
    {
      "source": "/api/agents/audio/voices/process",
      "destination": "/api/agents/audio/voices/status?action=process"
    },
    {
      "source": "/api/agents/audio/voices/synthesize",
      "destination": "/api/agents/audio/voices/status?action=synthesize"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
